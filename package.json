{
  "name": "xin-wang-academic-homepage",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "HugoBlox Academic-CV homepage and browser verification",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify --cleanDestinationDir",
    "verify": "node scripts/browser-check.cjs && node scripts/account-db-check.cjs && node scripts/account-browser-check.cjs",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "dompurify": "3.4.16",
    "marked": "18.0.14",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.62.1"
  }
}
